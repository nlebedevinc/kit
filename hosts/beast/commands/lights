#!/usr/bin/env bash
# kit lights (also installed as /usr/local/bin/kit-lights): RGB control for beast.
# SPEC §10, SETUP-LOG §8.
#
# Devices are found by name at runtime (indices change when hardware changes).
# MSI MYSTIC LIGHT only accepts Direct, and its zone sizes must be set in the same
# openrgb call as the color, before -c, for every zone.
# Standalone on purpose: the boot service runs it as root without kit's checkout.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: kit lights on | off | RRGGBB | status | detect   [--dry-run]

  on        RAM in LIGHTS_ON_RAM_MODE (Rainbow), GPU and motherboard in LIGHTS_ON_COLOR
  off       everything off
  RRGGBB    everything one color, e.g. kit lights 00AAFF
  status    detected devices and how they're mapped
  detect    detect devices and print the matching config lines

Note: `on` can't bring back the motherboard's built-in rainbow animation
(OpenRGB can only send it static colors). To restore it, set LIGHTS_BOOT=hardware,
run kit install lights, then fully power-cycle the machine (PSU off ~30 s).
See docs/hosts/beast/troubleshooting.md.
EOF
}

load_config() {
  local conf=${KIT_LIGHTS_CONF:-/etc/kit/lights.conf} user_conf
  if [ -r "$conf" ]; then
    # shellcheck source=/dev/null
    . "$conf"
  elif [ -n "${KIT_HOST_DIR:-}" ] && [ -r "$KIT_HOST_DIR/host.conf" ]; then
    # shellcheck source=/dev/null
    . "$KIT_HOST_DIR/host.conf"
    user_conf="${XDG_CONFIG_HOME:-$HOME/.config}/kit/kit.conf"
    if [ -r "$user_conf" ]; then
      # shellcheck source=/dev/null
      . "$user_conf"
    fi
  fi
  OPENRGB_BIN=${OPENRGB_BIN:-/usr/local/bin/openrgb}
  LIGHTS_RAM_DEVICES=${LIGHTS_RAM_DEVICES:-ENE DRAM}
  LIGHTS_GPU_DEVICE=${LIGHTS_GPU_DEVICE:-GeForce}
  LIGHTS_MB_DEVICE=${LIGHTS_MB_DEVICE:-MSI MYSTIC LIGHT}
  LIGHTS_MB_ZONES=${LIGHTS_MB_ZONES:-0 1 2 3}
  LIGHTS_MB_ZONE_SIZE=${LIGHTS_MB_ZONE_SIZE:-120}
  LIGHTS_ON_RAM_MODE=${LIGHTS_ON_RAM_MODE:-Rainbow}
  LIGHTS_ON_COLOR=${LIGHTS_ON_COLOR:-FFFFFF}
}

die() {
  printf 'lights: %s\n' "$*" >&2
  exit 1
}

is_color() { printf '%s' "$1" | grep -Eq '^[0-9A-Fa-f]{6}$'; }

# ---------------------------------------------------------------- devices

DEVICES='' # "index<TAB>name" per line
RAM='' GPU='' MB=''

detect_devices() {
  local out
  [ -x "$OPENRGB_BIN" ] || die "OpenRGB isn't installed at $OPENRGB_BIN (kit install openrgb)"
  out=$("$OPENRGB_BIN" --noautoconnect -l 2>&1 || true)
  DEVICES=$(printf '%s\n' "$out" | sed -n 's/^\([0-9][0-9]*\): \(.*\)$/\1	\2/p')
  if [ -z "$DEVICES" ]; then
    if [ "$(id -u)" -ne 0 ] && [ ! -f /etc/udev/rules.d/60-openrgb.rules ]; then
      die "no RGB devices found. Without the udev rules this needs root: sudo kit-lights … (or kit install openrgb)"
    fi
    die "no RGB devices found (are i2c-dev and i2c-i801 loaded? sudo modprobe -a i2c-dev i2c-i801)"
  fi
  RAM=$(indices_matching "$LIGHTS_RAM_DEVICES")
  GPU=$(indices_matching "$LIGHTS_GPU_DEVICE" | head -n 1)
  MB=$(indices_matching "$LIGHTS_MB_DEVICE" | head -n 1)
  [ -n "$RAM" ] || printf 'lights: warning: no device named "%s" (RAM)\n' "$LIGHTS_RAM_DEVICES" >&2
  [ -n "$GPU" ] || printf 'lights: warning: no device named "%s" (GPU)\n' "$LIGHTS_GPU_DEVICE" >&2
  [ -n "$MB" ] || printf 'lights: warning: no device named "%s" (motherboard)\n' "$LIGHTS_MB_DEVICE" >&2
  return 0
}

# indices_matching NAME: indices of devices whose name contains NAME.
indices_matching() {
  printf '%s\n' "$DEVICES" | awk -F '\t' -v n="$1" 'index($2, n) { print $1 }'
}

# ---------------------------------------------------------------- one openrgb call per action

ARGS=()

ram() { # ram MODE [COLOR]
  local i
  for i in $RAM; do
    ARGS+=(-d "$i" -m "$1")
    if [ -n "${2:-}" ]; then ARGS+=(-c "$2"); fi
  done
}

gpu() { # gpu MODE COLOR [BRIGHTNESS]
  [ -n "$GPU" ] || return 0
  ARGS+=(-d "$GPU" -m "$1" -c "$2")
  if [ -n "${3:-}" ]; then ARGS+=(-b "$3"); fi
}

mb() { # mb COLOR: Direct, and every zone sized before its color, in this same call
  local z
  [ -n "$MB" ] || return 0
  ARGS+=(-d "$MB" -m Direct)
  for z in $LIGHTS_MB_ZONES; do
    ARGS+=(-z "$z" -sz "$LIGHTS_MB_ZONE_SIZE" -c "$1")
  done
}

openrgb() { # run (or print) one openrgb call with ARGS, then reset them
  [ ${#ARGS[@]} -gt 0 ] || return 0
  if [ "$DRY_RUN" = 1 ]; then
    printf '[dry-run] %s --noautoconnect %s\n' "$OPENRGB_BIN" "${ARGS[*]}"
  else
    "$OPENRGB_BIN" --noautoconnect "${ARGS[@]}" >/dev/null
  fi
  ARGS=()
}

# ---------------------------------------------------------------- commands

lights_off() {
  ram Off
  gpu Direct 000000
  mb 000000
  openrgb
  # The GPU has no Off mode; static black at brightness 0 is the fallback.
  gpu Static 000000 0
  openrgb
  echo "Lights off"
}

lights_on() {
  ram "$LIGHTS_ON_RAM_MODE"
  gpu Static "$LIGHTS_ON_COLOR" 100
  mb "$LIGHTS_ON_COLOR"
  openrgb
  echo "Lights on"
}

lights_color() {
  ram Static "$1"
  gpu Static "$1" 100
  mb "$1"
  openrgb
  echo "Lights set to #$1"
}

lights_status() {
  echo "Devices:"
  printf '%s\n' "$DEVICES" | awk -F '\t' '{ printf "  %s: %s\n", $1, $2 }'
  echo "Mapping:"
  echo "  RAM (\"$LIGHTS_RAM_DEVICES\"):         $(printf '%s' "${RAM:-not found}" | tr '\n' ' ')"
  echo "  GPU (\"$LIGHTS_GPU_DEVICE\"):          ${GPU:-not found}"
  echo "  Motherboard (\"$LIGHTS_MB_DEVICE\"): ${MB:-not found} (zones $LIGHTS_MB_ZONES, $LIGHTS_MB_ZONE_SIZE LEDs each)"
}

lights_detect() {
  lights_status
  echo
  echo "Config lines for ~/.config/kit/kit.conf (then: kit install lights):"
  printf '%s\n' "$DEVICES" | awk -F '\t' '{ print "  # " $1 ": " $2 }'
  echo "  LIGHTS_RAM_DEVICES=\"$LIGHTS_RAM_DEVICES\""
  echo "  LIGHTS_GPU_DEVICE=\"$LIGHTS_GPU_DEVICE\""
  echo "  LIGHTS_MB_DEVICE=\"$LIGHTS_MB_DEVICE\""
}

main() {
  local action=''
  DRY_RUN=${KIT_DRY_RUN:-0}
  while [ $# -gt 0 ]; do
    case $1 in
      -n | --dry-run) DRY_RUN=1 ;;
      -h | --help | help)
        usage
        return 0
        ;;
      -*) die "unknown flag: $1 (see kit lights --help)" ;;
      *)
        [ -z "$action" ] || die "one action at a time (see kit lights --help)"
        action=$1
        ;;
    esac
    shift
  done
  [ -n "$action" ] || {
    usage
    return 1
  }
  case $action in
    on | off | status | detect) ;;
    *) is_color "$action" || die "not a color or command: $action (use RRGGBB, e.g. 00AAFF)" ;;
  esac

  load_config
  detect_devices
  case $action in
    on) lights_on ;;
    off) lights_off ;;
    status) lights_status ;;
    detect) lights_detect ;;
    *) lights_color "$(printf '%s' "$action" | tr '[:lower:]' '[:upper:]')" ;;
  esac
}

main "$@"

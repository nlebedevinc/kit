{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctor.schema.json",
  "title": "beast-check --json / beast doctor --json",
  "type": "object",
  "required": ["version", "host", "timestamp", "summary", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "host": {"type": "string"},
    "timestamp": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["pass", "warn", "fail", "skip"],
      "additionalProperties": false,
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "section", "status", "message"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "section": {"enum": ["hardware", "storage", "stability", "network", "services", "client"]},
          "status": {"enum": ["pass", "warn", "fail", "skip"]},
          "message": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    }
  }
}

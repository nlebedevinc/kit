#!/usr/bin/env bash
# Fake systemctl. State: $STUBSTATE/enabled.<unit>, $STUBSTATE/default, $STUBSTATE/unit.<unit>
case $1 in
  is-enabled)
    if [ -f "$STUBSTATE/enabled.$2" ]; then cat "$STUBSTATE/enabled.$2"; exit 0; fi
    echo disabled; exit 1 ;;
  get-default) cat "$STUBSTATE/default" 2>/dev/null || echo graphical.target ;;
  cat) [ -f "$STUBSTATE/unit.$2" ] ;;
  *) echo "REAL-SYSTEMCTL-CALLED $*" >>"$STUBSTATE/side-effects"; exit 0 ;;
esac

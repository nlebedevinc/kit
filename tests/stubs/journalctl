#!/usr/bin/env bash
case " $* " in
  *" -k "*) [ -z "${STUB_MCE:-}" ] || echo "mce: [Hardware Error]: Machine check events logged" ;;
  *" -n 1 "*) [ "${STUB_NO_PREV:-0}" != 1 ] || exit 1; echo "Nov 21 08:00:00 beast systemd[1]: Shutting down." ;;
  *" -n 30 "*) [ "${STUB_UNCLEAN:-0}" = 1 ] || echo "Nov 21 08:00:01 beast systemd-journald[1]: Journal stopped" ;;
esac

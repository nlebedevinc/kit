#!/usr/bin/env bash
# Fake nmcli: one active Wi-Fi profile whose password lives in the desktop keyring.
case "$*" in
  "-t -f TYPE,NAME connection show --active") echo '802-11-wireless:Home\:Net' ;;
  "-g connection.id connection show Home:Net") echo 'Home:Net' ;;
  "-g connection.permissions connection show Home:Net") echo 'user\:me' ;;
  "-g 802-11-wireless-security.psk-flags connection show Home:Net") echo '1 (agent-owned)' ;;
  "-g 802-11-wireless-security.key-mgmt connection show Home:Net") echo 'wpa-psk' ;;
  "-g connection.autoconnect connection show Home:Net") echo 'yes' ;;
  *) echo "NMCLI $*" >>"$STUBSTATE/side-effects"; exit 1 ;;
esac

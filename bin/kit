#!/usr/bin/env bash
# kit: set up this machine from its host profile. See SPEC.md.
set -euo pipefail

KIT_VERSION=0.1.0

_kit_root() {
  # Resolve symlinks without readlink -f (not on macOS bash 3.2 systems).
  local src=${BASH_SOURCE[0]} dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}
KIT_ROOT=${KIT_ROOT:-$(_kit_root)}

# shellcheck source=../lib/common.sh
. "$KIT_ROOT/lib/common.sh"
# shellcheck source=../lib/ubuntu.sh
. "$KIT_ROOT/lib/ubuntu.sh"
# shellcheck source=../lib/config.sh
. "$KIT_ROOT/lib/config.sh"
# shellcheck source=../lib/modules.sh
. "$KIT_ROOT/lib/modules.sh"

KIT_BUILTINS=" install list doctor update uninstall hosts config gui help version __module "
KIT_GLOBAL_ARGS=()

usage_error() {
  err "$1"
  printf "Run 'kit help' for usage.\n" >&2
  exit 2
}

# ---------------------------------------------------------------- help

cmd_help() {
  case ${1:-} in
    install) say "kit install [module...]
  Run all of this host's modules in order, or only the ones named.
  Each module is skipped if it doesn't apply here, reported 'already done' if
  it's applied, and applied otherwise. Safe to run again at any time." ;;
    list) say "kit list
  Show this host's modules: ✅ applied, ⬜ not applied, ⏭ not applicable here." ;;
    doctor) say "kit doctor
  Run every verification check and print a pass/fail table. Exits 1 if any fail." ;;
    update) say "kit update
  Pull the latest kit (git pull --ff-only), update system packages, then run kit install." ;;
    uninstall) say "kit uninstall <module>
  Revert a module, where the module supports it." ;;
    hosts) say "kit hosts
  List the host profiles in hosts/ and show which one this machine uses." ;;
    config) say "kit config
  Print the effective settings (host profile + your overrides). Secrets are hidden." ;;
    gui) say "kit gui on|off|start|stop   (Ubuntu)
  on/off: boot to the desktop or to the command line (takes effect at next boot).
  start/stop: start or stop the desktop now (gdm).
  No argument: show the current state." ;;
    *) say "kit $KIT_VERSION: set up this machine from its host profile

Usage: kit [flags] <command> [args]

Commands:
  install [module...]   run all modules for this host, or the ones named
  list                  modules and whether each is applied
  doctor                run all verification checks
  update                pull the latest kit, update packages, re-run install
  uninstall <module>    revert a module, where supported
  hosts                 list host profiles
  config                show the effective settings
  gui on|off|start|stop desktop on/off at boot, or start/stop it now (Ubuntu)
  help [command]        help for a command
  version               print the version
$(host_commands_help)
Flags:
  --host NAME           use this host profile (default: from the hostname)
  -n, --dry-run         print what would change, change nothing
  -y, --yes             answer yes to confirmations (never skips safety checks)
  -v, --verbose         show every command as it runs
  --fix                 allow repairs that are off by default (e.g. GPU driver install)
  --no-color            plain output (also: NO_COLOR=1)" ;;
  esac
}

host_commands_help() {
  local host f out=''
  host=$(KIT_NO_TTY=1 resolve_host "${KIT_HOST_FLAG:-}" 2>/dev/null) || return 0
  for f in "$KIT_ROOT/hosts/$host/commands"/*; do
    [ -f "$f" ] || continue
    out="$out  $(basename "$f")"$'\n'
  done
  if [ -n "$out" ]; then
    printf '\nCommands for host %s (kit <command> --help):\n%s' "$host" "$out"
  fi
}

cmd_version() {
  local rev=''
  if [ -d "$KIT_ROOT/.git" ] && have git; then
    rev=$(git -C "$KIT_ROOT" describe --always --dirty --tags 2>/dev/null || true)
  fi
  say "kit $KIT_VERSION${rev:+ ($rev)}"
}

# ---------------------------------------------------------------- preflight

# Runs before `kit install`: OS match, Ubuntu version, session type, hostname.
kit_preflight() {
  local os ver='' host
  os=$(detect_os)
  # shellcheck disable=SC2153  # KIT_OS is set by load_config
  if [ "$os" != "$KIT_OS" ]; then
    if [ "$KIT_DRY_RUN" = 1 ]; then
      warn "Host '$KIT_HOST' is for $KIT_OS, but this machine runs $os. Continuing only because of --dry-run."
    else
      err "Host '$KIT_HOST' is for $KIT_OS, but this machine runs $os."
      return 1
    fi
  fi
  if [ "$os" = ubuntu ]; then
    ver=$(os_release_value VERSION_ID)
    case $ver in
      24.04 | 26.04) ;;
      *) warn "Ubuntu ${ver:-unknown} isn't tested (24.04 and 26.04 are). Continuing." ;;
    esac
  fi
  host=$(current_hostname)
  if [ -n "${HOST_NAME:-}" ] && [ "$host" != "$HOST_NAME" ]; then
    warn "This machine is named '$host', but host '$KIT_HOST' expects '$HOST_NAME'. kit won't rename it."
  fi
  if is_ssh_session; then
    KIT_SESSION=ssh
  else
    KIT_SESSION=local
  fi
  export KIT_SESSION
  local mode=''
  [ "$KIT_DRY_RUN" != 1 ] || mode=' · dry run'
  say "kit $KIT_VERSION · host ${C_BOLD}$KIT_HOST${C_RESET} · $os${ver:+ $ver} · $KIT_SESSION session$mode"
}

# ---------------------------------------------------------------- install

validate_modules() {
  local m
  for m in "$@"; do
    module_file "$m" >/dev/null || usage_error "Unknown module '$m' for host $KIT_HOST. Modules: $KIT_MODULES"
  done
}

cmd_install() {
  local mods m rc reason desc
  local n_done=0 n_applied=0 n_skipped=0 failed='' blocked=''
  if [ $# -gt 0 ]; then mods="$*"; else mods=$KIT_MODULES; fi
  [ -n "${mods// /}" ] || die "Host '$KIT_HOST' has no modules (KIT_MODULES is empty)"
  # shellcheck disable=SC2086  # module list is space-separated
  validate_modules $mods
  kit_preflight
  ensure_sudo

  for m in $mods; do
    desc=$(module_call "$m" describe 2>/dev/null || true)
    header "$m" "$desc"
    if ! reason=$(module_call "$m" applies 2>&1); then
      info "skipped: ${reason:-not applicable here}"
      n_skipped=$((n_skipped + 1))
      continue
    fi
    if module_call_quiet "$m" check; then
      ok "already done"
      n_done=$((n_done + 1))
      continue
    fi
    rc=0
    module_call "$m" apply || rc=$?
    case $rc in
      0)
        if [ "$KIT_DRY_RUN" = 1 ]; then
          info "would apply (dry run)"
          n_applied=$((n_applied + 1))
        elif module_call "$m" verify; then
          ok "applied"
          n_applied=$((n_applied + 1))
        else
          err "$m: applied, but verification failed"
          failed="$failed $m"
        fi
        ;;
      "$KIT_BLOCKED")
        warn "$m: blocked by a safety check (see above)"
        blocked="$blocked $m"
        ;;
      "$KIT_SKIPPED")
        info "skipped for now"
        n_skipped=$((n_skipped + 1))
        ;;
      *)
        err "$m: failed"
        failed="$failed $m"
        ;;
    esac
  done

  printf '\n%sSummary:%s %s already done, %s %s, %s skipped' "$C_BOLD" "$C_RESET" \
    "$n_done" "$n_applied" "$([ "$KIT_DRY_RUN" = 1 ] && echo 'would apply' || echo applied)" "$n_skipped"
  [ -z "$blocked" ] || printf ', blocked:%s' "$blocked"
  [ -z "$failed" ] || printf ', failed:%s' "$failed"
  printf '\n'
  if [ -n "$failed" ]; then return 1; fi
  if [ -n "$blocked" ]; then return "$KIT_BLOCKED"; fi
  return 0
}

# ---------------------------------------------------------------- list / doctor

cmd_list() {
  local m desc reason
  [ $# -eq 0 ] || usage_error "kit list takes no arguments"
  # shellcheck disable=SC2086
  validate_modules $KIT_MODULES
  ensure_sudo
  say "Host ${C_BOLD}$KIT_HOST${C_RESET}:"
  for m in $KIT_MODULES; do
    desc=$(module_call "$m" describe 2>/dev/null || true)
    if ! reason=$(module_call "$m" applies 2>&1); then
      printf '  ⏭  %-16s %s (%s)\n' "$m" "$desc" "${reason:-not applicable}"
    elif module_call_quiet "$m" check; then
      printf '  ✅ %-16s %s\n' "$m" "$desc"
    else
      printf '  ⬜ %-16s %s\n' "$m" "$desc"
    fi
  done
}

cmd_doctor() {
  local m reason failed=''
  [ $# -eq 0 ] || usage_error "kit doctor takes no arguments"
  # shellcheck disable=SC2086
  validate_modules $KIT_MODULES
  ensure_sudo
  say "kit doctor · host ${C_BOLD}$KIT_HOST${C_RESET}"
  for m in $KIT_MODULES; do
    printf '\n%s%s%s\n' "$C_BOLD" "$m" "$C_RESET"
    if ! reason=$(module_call "$m" applies 2>&1); then
      report skip "not applicable: ${reason:-not applicable here}"
      continue
    fi
    module_call "$m" verify || failed="$failed $m"
  done
  if [ -n "$failed" ]; then
    printf '\n❌ Problems in:%s\n' "$failed"
    return 1
  fi
  printf '\n✅ All checks passed\n'
}

# ---------------------------------------------------------------- update / uninstall

cmd_update() {
  local m
  [ $# -eq 0 ] || usage_error "kit update takes no arguments"
  if [ -d "$KIT_ROOT/.git" ]; then
    if [ -n "$(git -C "$KIT_ROOT" status --porcelain)" ]; then
      die "$KIT_ROOT has local changes. Commit or stash them, then run kit update again."
    fi
    header "kit" "update from git"
    run_cmd git -C "$KIT_ROOT" pull --ff-only
  else
    warn "$KIT_ROOT isn't a git checkout; skipping the kit update"
  fi
  ensure_sudo
  for m in $KIT_MODULES; do
    module_file "$m" >/dev/null || continue
    module_call "$m" applies >/dev/null 2>&1 || continue
    module_call "$m" update
  done
  # Re-exec so the freshly pulled code runs the install.
  exec "$BASH" "$KIT_ROOT/bin/kit" ${KIT_GLOBAL_ARGS[@]+"${KIT_GLOBAL_ARGS[@]}"} install
}

cmd_uninstall() {
  [ $# -ge 1 ] || usage_error "Usage: kit uninstall <module>..."
  validate_modules "$@"
  ensure_sudo
  local m rc=0
  for m in "$@"; do
    header "$m" "uninstall"
    module_call "$m" uninstall || rc=1
  done
  return "$rc"
}

# ---------------------------------------------------------------- hosts / config / gui

cmd_hosts() {
  local active h
  active=$(KIT_NO_TTY=1 resolve_host "${KIT_HOST_FLAG:-}" 2>/dev/null || true)
  for h in $(kit_hosts); do
    if [ "$h" = "$active" ]; then
      printf '* %s\n' "$h"
    else
      printf '  %s\n' "$h"
    fi
  done
  [ -n "$active" ] || say "(none matches this machine; use --host NAME)"
}

cmd_config() {
  local key user_conf
  user_conf=$(kit_user_config)
  say "# host:        $KIT_HOST ($KIT_HOST_DIR/host.conf)"
  if [ -f "$user_conf" ]; then
    say "# user config: $user_conf"
  else
    say "# user config: $user_conf (not created yet)"
  fi
  for key in $KIT_CONFIG_KEYS; do
    if is_secret_key "$key"; then
      say "$key=<hidden>"
    else
      say "$key=$(printf '%q' "${!key-}")"
    fi
  done
  if [ -n "${TAILSCALE_AUTHKEY:-}" ]; then say "TAILSCALE_AUTHKEY=<hidden, from environment>"; fi
}

cmd_gui() {
  [ "$(detect_os)" = ubuntu ] || die "kit gui is for Ubuntu"
  case ${1:-} in
    on)
      run_sudo systemctl set-default graphical.target
      info "The desktop starts at the next boot. Start it now with: kit gui start"
      ;;
    off)
      run_sudo systemctl set-default multi-user.target
      info "The machine boots to the command line from the next boot. Stop the desktop now with: kit gui stop"
      ;;
    start) run_sudo systemctl start gdm ;;
    stop) run_sudo systemctl stop gdm ;;
    '')
      say "Boot target: $(systemctl get-default)"
      say "Desktop (gdm): $(systemctl is-active gdm 2>/dev/null || true)"
      ;;
    *) usage_error "Usage: kit gui on|off|start|stop" ;;
  esac
}

# ---------------------------------------------------------------- host commands

run_host_command() {
  local name=$1 file
  shift
  file="$KIT_HOST_DIR/commands/$name"
  if ! valid_name "$name" || [ ! -f "$file" ]; then
    usage_error "Unknown command '$name'"
  fi
  export KIT_HOST KIT_HOST_DIR
  exec "$BASH" "$file" "$@"
}

# ---------------------------------------------------------------- main

main() {
  local cmd='' want_help=0 args=()
  KIT_HOST_FLAG=''

  while [ $# -gt 0 ]; do
    case $1 in
      --host)
        [ $# -ge 2 ] || usage_error "--host needs a value"
        KIT_HOST_FLAG=$2
        KIT_GLOBAL_ARGS+=(--host "$2")
        shift
        ;;
      --host=*)
        KIT_HOST_FLAG=${1#*=}
        KIT_GLOBAL_ARGS+=("$1")
        ;;
      -n | --dry-run)
        KIT_DRY_RUN=1
        KIT_GLOBAL_ARGS+=(--dry-run)
        ;;
      -y | --yes)
        KIT_YES=1
        KIT_GLOBAL_ARGS+=(--yes)
        ;;
      -v | --verbose)
        KIT_VERBOSE=1
        KIT_GLOBAL_ARGS+=(--verbose)
        ;;
      --fix)
        KIT_FIX=1
        KIT_GLOBAL_ARGS+=(--fix)
        ;;
      --no-color)
        KIT_NO_COLOR=1
        KIT_GLOBAL_ARGS+=(--no-color)
        ;;
      -h | --help) want_help=1 ;;
      --version) cmd=version ;;
      --) ;;
      -*) usage_error "Unknown flag: $1" ;;
      *)
        if [ -z "$cmd" ]; then
          cmd=$1
          case $KIT_BUILTINS in
            *" $cmd "*) ;;
            *)
              # Host command: everything after it is passed through untouched.
              shift
              args=("$@")
              break
              ;;
          esac
        else
          args+=("$1")
        fi
        ;;
    esac
    shift
  done

  kit_color_init
  export KIT_ROOT KIT_DRY_RUN KIT_YES KIT_VERBOSE KIT_FIX KIT_NO_COLOR

  if [ "$want_help" = 1 ] && [ -z "$cmd" ]; then cmd=help; fi
  case $cmd in
    '' | help)
      cmd_help ${args[@]+"${args[@]}"}
      return 0
      ;;
    version)
      cmd_version
      return 0
      ;;
  esac
  if [ "$want_help" = 1 ] && is_builtin "$cmd"; then
    cmd_help "$cmd"
    return 0
  fi

  require_not_root

  case $cmd in
    hosts)
      cmd_hosts
      return 0
      ;;
    gui)
      cmd_gui ${args[@]+"${args[@]}"}
      return 0
      ;;
    __module)
      # Internal: run one module function in this (child) process.
      [ ${#args[@]} -eq 2 ] || usage_error "internal: __module NAME FUNC"
      load_config "${KIT_HOST:?internal: KIT_HOST not set}"
      module_exec "${args[0]}" "${args[1]}"
      return
      ;;
  esac

  local host
  host=$(resolve_host "$KIT_HOST_FLAG") || exit 2
  load_config "$host"
  export KIT_HOST KIT_HOST_DIR

  case $cmd in
    install) cmd_install ${args[@]+"${args[@]}"} ;;
    list) cmd_list ${args[@]+"${args[@]}"} ;;
    doctor) cmd_doctor ${args[@]+"${args[@]}"} ;;
    update) cmd_update ${args[@]+"${args[@]}"} ;;
    uninstall) cmd_uninstall ${args[@]+"${args[@]}"} ;;
    config) cmd_config ${args[@]+"${args[@]}"} ;;
    *) run_host_command "$cmd" ${args[@]+"${args[@]}"} ;;
  esac
}

is_builtin() {
  case $KIT_BUILTINS in *" $1 "*) return 0 ;; esac
  return 1
}

main "$@"
